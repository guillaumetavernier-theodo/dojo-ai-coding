{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-factory.sh\" ] || exit 0; sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-factory.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
